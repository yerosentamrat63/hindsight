<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 · ring: wasted today around a limit ring. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="13dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <TextView
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wasted today" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/ring_chart"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/ring_value"
                style="@style/WidgetNumber"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:text="0m"
                android:textSize="19sp"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/ring_footer"
            style="@style/WidgetMonoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="under limit"
            android:textColor="#FF6B3D"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
