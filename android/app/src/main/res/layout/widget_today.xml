<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 · today: total screen time, the top three apps and the split. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="42"
                android:orientation="vertical">

                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen time" />

                <TextView
                    android:id="@+id/today_total"
                    style="@style/WidgetNumber"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:text="0m"
                    android:textSize="33sp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="20sp"
                    android:autoSizeMaxTextSize="33sp" />

                <TextView
                    android:id="@+id/today_delta"
                    style="@style/WidgetMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="same as yesterday"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="58"
                android:layout_marginStart="14dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/app_row_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/app_badge_0"
                        style="@style/WidgetMonoBold"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge"
                        android:gravity="center"
                        android:text="Tk"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/app_name_0"
                        style="@style/WidgetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="TikTok"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/app_time_0"
                        style="@style/WidgetMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="2h 40m" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/app_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/app_badge_1"
                        style="@style/WidgetMonoBold"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge"
                        android:gravity="center"
                        android:text="Ig"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/app_name_1"
                        style="@style/WidgetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Instagram"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/app_time_1"
                        style="@style/WidgetMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="1h 05m" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/app_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/app_badge_2"
                        style="@style/WidgetMonoBold"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge"
                        android:gravity="center"
                        android:text="Tg"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/app_name_2"
                        style="@style/WidgetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Telegram"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/app_time_2"
                        style="@style/WidgetMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="52m" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/today_split"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_wasted"
                style="@style/WidgetMono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wasted"
                android:textSize="9sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/today_neutral"
                style="@style/WidgetMono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Neutral"
                android:textSize="9sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/today_productive"
                style="@style/WidgetMono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Productive"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
